// Schema Xóm Nhỏ. Giải thích bảng, quan hệ, chỉ mục: docs/co-so-du-lieu.md
// Kết nối (DATABASE_URL) khai báo ở backend/prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../../backend/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum PostStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

// MARKDOWN: bài kiểu diễn đàn (có trước). PLAIN: bài soạn kiểu mạng xã hội, chữ thường giữ xuống dòng
enum ContentFormat {
  MARKDOWN
  PLAIN
}

enum MediaKind {
  IMAGE
  VIDEO
}

// File dùng vào việc gì: ảnh, video trong bài hay ảnh đại diện (sau này thêm ảnh bìa, file trong tin nhắn)
enum MediaPurpose {
  POST
  AVATAR
}

// Cột lõi theo Better Auth (+ plugin admin: role, banned, banReason, banExpires).
// Id do Better Auth sinh (32 ký tự), không dùng cuid().
model User {
  id            String    @id @db.VarChar(36)
  name          String    @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false)
  image         String?   @db.VarChar(500)
  role          String    @default("user") @db.VarChar(20)
  banned        Boolean   @default(false)
  banReason     String?   @db.VarChar(500)
  banExpires    DateTime?
  // Cột riêng của Xóm Nhỏ
  username      String?   @unique @db.VarChar(50)
  bio           String?   @db.Text
  // Ảnh đại diện tải lên (media purpose AVATAR). Có thì hiện ảnh này, không thì hiện `image` (link Google/GitHub)
  avatarId      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  avatar        Media?        @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  posts         Post[]        @relation("PostAuthor")
  reviewedPosts Post[]        @relation("PostReviewer")
  comments      Comment[]
  media         Media[]       @relation("MediaOwner")
  postLikes     PostLike[]
  postDislikes  PostDislike[]
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

// Ba bảng dưới do Better Auth quản lý (cột theo better-auth 1.7, bảng core + plugin admin).
// Không đọc/ghi trực tiếp từ repository; đi qua Better Auth.

model Session {
  id             String   @id @db.VarChar(36)
  expiresAt      DateTime
  token          String   @unique @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.Text
  userId         String   @db.VarChar(36)
  // Plugin admin: id trưởng xóm đang đóng vai người này
  impersonatedBy String?  @db.VarChar(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Mỗi cách đăng nhập của một người: "credential" (email + mật khẩu băm), "google", "github"
model Account {
  id                    String    @id @db.VarChar(36)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(50)
  userId                String    @db.VarChar(36)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.VarChar(36)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(60)
  description String?  @db.VarChar(300)
  // Khóa màu badge: amber | blue | green | purple | rose (api/src/constants/category-colors.ts)
  color       String   @default("amber") @db.VarChar(20)
  // Khóa biểu tượng: tea | chip | notebook | moon | question (api/src/constants/category-icons.ts).
  // null: chưa có biểu tượng, giao diện hiện chấm màu.
  icon        String?  @db.VarChar(20)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]

  @@index([sortOrder])
  @@map("category")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(30)
  slug      String   @unique @db.VarChar(40)
  createdAt DateTime @default(now())

  posts PostTag[]

  @@map("tag")
}

model Post {
  id            String        @id @default(cuid())
  title         String        @db.VarChar(200)
  slug          String        @unique @db.VarChar(220)
  excerpt       String        @db.VarChar(160)
  // MEDIUMTEXT (16 MB): TEXT chỉ 64 KB, bài tiếng Việt dài dễ vượt
  content       String        @db.MediumText
  contentFormat ContentFormat @default(MARKDOWN)
  // Tiêu đề + tóm tắt + tên tag, đã bỏ dấu và chữ thường (toSearchText trong api)
  searchText    String        @db.Text
  status        PostStatus    @default(DRAFT)
  rejectReason  String?       @db.VarChar(500)
  viewCount     Int           @default(0)
  authorId      String        @db.VarChar(36)
  categoryId    String
  reviewerId    String?       @db.VarChar(36)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Không xóa người dùng hay danh mục khi còn bài
  author   User          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviewer User?         @relation("PostReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  tags     PostTag[]
  comments Comment[]
  media    Media[]
  likes    PostLike[]
  dislikes PostDislike[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt])
  @@index([authorId, status, publishedAt])
  @@fulltext([searchText])
  @@map("post")
}

// Ảnh, video người dùng tải lên (ADR 0005), lưu trên ổ đĩa backend. Tải lên trước (postId null),
// gắn vào bài khi đăng. File trên đĩa tên theo storageKey (ngẫu nhiên), không dùng tên gốc.
model Media {
  id         String       @id @default(cuid())
  kind       MediaKind
  purpose    MediaPurpose @default(POST)
  mimeType   String       @db.VarChar(50)
  sizeBytes  Int
  storageKey String       @unique @db.VarChar(100)
  ownerId    String       @db.VarChar(36)
  postId     String?
  // Thứ tự hiển thị trong bài, từ 0
  position   Int          @default(0)
  createdAt  DateTime     @default(now())

  owner    User  @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Người đang dùng file này làm ảnh đại diện
  avatarOf User? @relation("UserAvatar")
  // Xóa bài thì xóa dòng media (file trên đĩa do service dọn)
  post     Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
  // File chưa gắn bài của một người: kiểm tra khi đăng, dọn file bỏ dở
  @@index([ownerId, postId, createdAt])
  @@map("media")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tag")
}

// Một hàng xóm thích một bài. Khóa chính ghép: mỗi người thích mỗi bài một lần, ghi lặp lại không tăng số.
// Xóa bài hay người dùng thì lượt thích đi theo.
model PostLike {
  postId    String
  userId    String   @db.VarChar(36)
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  // Bài một người đã thích, mới trước (danh sách "đã thích" sau này) và khóa ngoại userId
  @@index([userId, createdAt])
  @@map("post_like")
}

// Không thích bài (ADR 0009). Như PostLike; một người chỉ Thích hoặc Không thích một bài, backend gỡ cái kia
// trong cùng transaction
model PostDislike {
  postId    String
  userId    String   @db.VarChar(36)
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  // Khóa ngoại userId (MySQL cần chỉ mục bắt đầu bằng cột này)
  @@index([userId, createdAt])
  @@map("post_dislike")
}

model Comment {
  id        String        @id @default(cuid())
  content   String        @db.Text
  status    CommentStatus @default(VISIBLE)
  postId    String
  authorId  String        @db.VarChar(36)
  // null = bình luận gốc. Trả lời chỉ một cấp: luôn trỏ về bình luận gốc
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  // Lần cuối người viết sửa nội dung; null = chưa sửa. Không dùng updatedAt vì admin ẩn/hiện cũng đổi cột đó
  editedAt  DateTime?

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, status, createdAt])
  @@index([parentId])
  @@map("comment")
}

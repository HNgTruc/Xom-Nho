{
  "name": "xom-nho",
  "private": true,
  "description": "Xóm Nhỏ: diễn đàn cộng đồng tiếng Việt (NestJS + Next.js + React/Vite + Expo)",
  "scripts": {
    "dev": "turbo run dev --continue=dependencies-successful",
    "dev:backend": "turbo run dev --continue=dependencies-successful --filter=backend",
    "dev:web": "turbo run dev --continue=dependencies-successful --filter=backend --filter=web",
    "dev:admin": "turbo run dev --continue=dependencies-successful --filter=backend --filter=admin",
    "dev:mobile": "turbo run dev --continue=dependencies-successful --filter=backend --filter=mobile-app",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write . \"!pnpm-lock.yaml\"",
    "db:compose": "docker compose --env-file .env -f database/docker-compose.yml",
    "db:up": "pnpm db:compose up -d",
    "db:down": "pnpm db:compose down",
    "db:ps": "pnpm db:compose ps"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "endOfLine": "lf"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  }
}

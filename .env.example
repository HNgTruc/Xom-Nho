# Danh sách đầy đủ biến môi trường. Sao chép thành .env rồi điền. KHÔNG commit .env.
# Mỗi phần có thể cần file .env riêng trong thư mục của nó (xem docs/thiet-lap-moi-truong.md).

# ===== Docker MySQL (database/docker-compose.yml đọc) =====
MYSQL_ROOT_PASSWORD=doi_mat_khau_root
MYSQL_DATABASE=xom_nho
MYSQL_USER=xomnho
MYSQL_PASSWORD=doi_mat_khau_xomnho

# ===== backend =====
PORT=4000
# Cổng 3307 ở máy thật trỏ vào 3306 trong container
DATABASE_URL="mysql://xomnho:doi_mat_khau_xomnho@localhost:3307/xom_nho"

# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Các frontend được phép gọi API (CORS + trustedOrigins), cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Scheme của app Expo (trùng "scheme" trong app.json)
MOBILE_APP_SCHEME=xomnho
# Thư mục lưu ảnh, video tải lên (ADR 0005), tương đối với thư mục backend/: ../media là media/ ở gốc repo,
# chia images/, videos/, avatars/. Khi deploy: ổ đĩa lưu lâu dài
UPLOAD_DIR=../media

# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===== frontend/web =====
# Server Components gọi backend
API_URL=http://localhost:4000
# Client Components gọi backend
NEXT_PUBLIC_API_URL=http://localhost:4000
# Địa chỉ công khai của web, làm gốc cho URL tuyệt đối trong Open Graph, canonical, sitemap
SITE_URL=http://localhost:3000

# ===== frontend/admin =====
VITE_API_URL=http://localhost:4000

# ===== frontend/mobile-app =====
# Điện thoại không gọi được "localhost" của máy tính: điền IP Wi-Fi của máy (ipconfig -> IPv4 Address)
EXPO_PUBLIC_API_URL=http://192.168.1.5:4000

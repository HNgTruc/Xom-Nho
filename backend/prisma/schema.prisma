// Schema Xóm Nhỏ. Giải thích bảng, quan hệ, chỉ mục: docs/co-so-du-lieu.md
// Kết nối (DATABASE_URL) khai báo ở prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum PostStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

// Cột lõi theo Better Auth (+ plugin admin: role, banned, banReason, banExpires).
// Bảng session, account, verification thêm ở giai đoạn 2 bằng CLI của Better Auth.
model User {
  id            String    @id @db.VarChar(36)
  name          String    @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false)
  image         String?   @db.VarChar(500)
  role          String    @default("user") @db.VarChar(20)
  banned        Boolean   @default(false)
  banReason     String?   @db.VarChar(500)
  banExpires    DateTime?
  // Cột riêng của Xóm Nhỏ
  username      String?   @unique @db.VarChar(50)
  bio           String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts         Post[]    @relation("PostAuthor")
  reviewedPosts Post[]    @relation("PostReviewer")
  comments      Comment[]

  @@map("user")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(60)
  description String?  @db.VarChar(300)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]

  @@index([sortOrder])
  @@map("category")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(30)
  slug      String   @unique @db.VarChar(40)
  createdAt DateTime @default(now())

  posts PostTag[]

  @@map("tag")
}

model Post {
  id           String     @id @default(cuid())
  title        String     @db.VarChar(200)
  slug         String     @unique @db.VarChar(220)
  excerpt      String     @db.VarChar(160)
  // MEDIUMTEXT (16 MB): TEXT chỉ 64 KB, bài tiếng Việt dài dễ vượt
  content      String     @db.MediumText
  // Tiêu đề + tóm tắt + tên tag, đã bỏ dấu và chữ thường (toSearchText trong shared)
  searchText   String     @db.Text
  status       PostStatus @default(DRAFT)
  rejectReason String?    @db.VarChar(500)
  viewCount    Int        @default(0)
  authorId     String     @db.VarChar(36)
  categoryId   String
  reviewerId   String?    @db.VarChar(36)
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Không xóa người dùng hay danh mục khi còn bài
  author   User      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviewer User?     @relation("PostReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  tags     PostTag[]
  comments Comment[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt])
  @@index([authorId, status])
  @@fulltext([searchText])
  @@map("post")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tag")
}

model Comment {
  id        String        @id @default(cuid())
  content   String        @db.Text
  status    CommentStatus @default(VISIBLE)
  postId    String
  authorId  String        @db.VarChar(36)
  // null = bình luận gốc. Trả lời chỉ một cấp: luôn trỏ về bình luận gốc
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, status, createdAt])
  @@index([parentId])
  @@map("comment")
}
